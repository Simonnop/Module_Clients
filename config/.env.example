# tester 模块环境变量配置示例
# 复制此文件为 .env 并填入实际配置值

# 服务器配置
SERVER_IP=your_server_ip
SERVER_PORT=11111

# WebSocket配置
HEARTBEAT_INTERVAL=10

# MongoDB 配置
MONGODB_URI=mongodb://admin:password@host:27017/?authSource=admin
MONGODB_DATABASE=finance_data
MONGODB_COLLECTION_BILI=bili_info
MONGODB_COLLECTION_BYDOC=bydoc_info

# 筛选的名称列表（用逗号分隔）
FILTER_NAMES=擒龙,战国时代,鉴茶,波段哥王安松,龙哥第一买点

# LLM API 配置
LLM_API_URL=http://localhost:10101/llm/ask
LLM_MODEL=qwen-plus
LLM_ENABLE_SEARCH=true

# 邮件发送配置
EMAIL_API_URL=http://localhost:10101/send
# 收件人邮箱列表（多个邮箱用逗号分隔）
EMAIL_TO=111111111@qq.com,222222222@qq.com
